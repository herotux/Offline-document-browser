<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Utility Documents"
           Manufacturer="herotux"
           Version="$(var.ProductVersion)"
           UpgradeCode="c98c2bbc-0bcc-4cc1-8e88-c0acdf806542"
           Scope="perMachine"
           Platform="x64">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Utility Documents is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="MainFeature" Title="Utility Documents" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Utility Documents" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Utility Documents" />
    </StandardDirectory>

    <ComponentGroup Id="ApplicationFiles">
      <Component Id="MainExecutable" Directory="INSTALLFOLDER" Guid="*">
        <File Id="UtilityDocumentsExe" Source="$(var.PublishDir)\UtilityDocuments.exe" KeyPath="yes" />
        <Shortcut Id="ApplicationShortcut"
                  Directory="ApplicationProgramsFolder"
                  Name="Utility Documents"
                  Description="Offline PDF and document browser"
                  Target="[#UtilityDocumentsExe]"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder"
                      Directory="ApplicationProgramsFolder"
                      On="uninstall" />
      </Component>
      <Component Id="PlaceholderPage" Directory="INSTALLFOLDER" Guid="*">
        <File Source="$(var.PublishDir)\placeholder.html" KeyPath="yes" />
      </Component>
      <Component Id="ApplicationIcon" Directory="INSTALLFOLDER" Guid="*">
        <File Source="$(var.PublishDir)\icon.ico" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
